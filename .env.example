# Public origin of this deployment. Used as Next.js `metadataBase` to build
# absolute Open Graph / Twitter image URLs. Set to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google Maps Embed API key for the map on /preview/places and /preview/events.
# Restrict it by HTTP referrer to your domains in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Extra merchant-dashboard origins (comma-separated) allowed to embed these pages in their
# preview modal and send draft listings to them. merchant.spinstrip.com and localhost are built in.
NEXT_PUBLIC_DASHBOARD_ORIGINS=
